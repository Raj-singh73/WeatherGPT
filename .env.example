# WeatherGPT Environment Configuration
# SIH 2026 Problem Statement SIH26068

# LLM Providers (Leave blank to use robust offline/demo synthesis engine)
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=auto  # Options: auto | gemini | openai | offline_demo

# Weather API (Open-Meteo free tier)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Database (Default uses local SQLite; PostgreSQL can be plugged in)
DATABASE_URL=sqlite:///./weathergpt.db

# Host & Port Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
